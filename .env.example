# Dedicated Metro Yazılım PostgreSQL database (do not reuse Metro Web)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/metro_yazilim?schema=public"
# At least 32 random characters; generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
# Used only by `npm run db:seed` to create or reset the first admin
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-password-of-at-least-12-characters"
# Used for canonical URLs in production
NEXT_PUBLIC_SITE_URL="https://example.com"

# Cloudflare R2 media storage
R2_ACCOUNT_ID="replace-with-r2-account-id"
R2_ACCESS_KEY_ID="replace-with-r2-access-key-id"
R2_SECRET_ACCESS_KEY="replace-with-r2-secret-access-key"
R2_BUCKET="replace-with-bucket-name"
R2_PUBLIC_BASE="https://cdn.example.com"

# Transactional e-mail (password reset, contact notifications)
SMTP_HOST="mail.example.com"
SMTP_PORT="465"
SMTP_USER="info@example.com"
SMTP_PASS="replace-with-smtp-password"
SMTP_FROM="info@example.com"

# Test runner defaults (never commit real test credentials or tokens)
# Must be a distinct local/CI-only test database; never reuse DATABASE_URL.
# Its role must be able to create/drop run-owned schemas.
TEST_DATABASE_URL="postgresql://TEST_USER:TEST_PASSWORD@localhost:5432/metro_yazilim_test?schema=public"
TEST_ENV="local"
BASE_URL="http://127.0.0.1:3000"
TEST_USER_IDENTIFIER="default"
